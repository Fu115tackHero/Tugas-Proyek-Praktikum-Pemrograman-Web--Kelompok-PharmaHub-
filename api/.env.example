# Database Connection (Local Development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmahub_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Database Connection (Production - Neon/Vercel)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# When DATABASE_URL is set, it takes precedence over DB_* variables above

# Connection Pool Settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Environment
NODE_ENV=development

# Server
PORT=3001

# JWT Secret (REQUIRED - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# KEEP THIS SECRET! Never commit to git!
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
VITE_PAYMENT_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false

# Demo Mode (for testing without Midtrans)
DEMO_MODE=false

# Supabase (if used)
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key
