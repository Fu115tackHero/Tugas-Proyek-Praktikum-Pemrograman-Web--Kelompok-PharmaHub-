DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

JWT_SECRET=your-secret-key-generate-random-64-characters

NODE_ENV=production

MIDTRANS_SERVER_KEY=Mid-server-xxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxx
MIDTRANS_IS_PRODUCTION=false

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

VITE_PAYMENT_CLIENT_KEY=Mid-client-xxxxx

VITE_GOOGLE_MAPS_API_KEY=AIzaSyxxxxx

VITE_API_URL=https://your-vercel-domain.vercel.app/api

# ============================================
# SUPABASE (Image/File Storage)
# ============================================
# Dashboard > Project > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_only_for_frontend

# Untuk backend operations (PRIVATE - jangan expose!)
SUPABASE_SERVICE_KEY=your_service_key_backend_only
SUPABASE_BUCKET_NAME=product-images

# ============================================
# MIDTRANS PAYMENT GATEWAY (Optional)
# ============================================
# Get dari Midtrans Dashboard: https://dashboard.sandbox.midtrans.com
# Sandbox (Testing): SB-Mid-server-xxxxx
# Production: Mid-server-xxxxx (JANGAN gunakan di development!)

MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key_sandbox
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key_sandbox

# Frontend client key (PUBLIC - OK di frontend)
VITE_PAYMENT_CLIENT_KEY=SB-Mid-client-your_client_key_sandbox

# false = Sandbox (Testing), true = Production (HATI-HATI!)
MIDTRANS_IS_PRODUCTION=false

# Demo mode (skip payment processing untuk testing)
DEMO_MODE=true

# ============================================
# GOOGLE MAPS (Optional - untuk tracking)
# ============================================
# Get dari Google Cloud Console > APIs & Services
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# API URLS
# ============================================
# Frontend URL untuk API calls
VITE_API_URL=http://localhost:3001/api

# ============================================
# SECURITY CHECKLIST
# ============================================
# ✅ BEFORE PUSHING TO GITHUB:
#    - [ ] Pastikan .env di .gitignore
#    - [ ] Jangan ada hardcoded secrets di kode
#    - [ ] JWT_SECRET lebih dari 64 karakter
#    - [ ] MIDTRANS_IS_PRODUCTION=false untuk development
#    - [ ] Gunakan environment variables untuk semua secrets
#
# ✅ BEFORE DEPLOYING TO VERCEL:
#    - [ ] Update DATABASE_URL ke Neon production
#    - [ ] Update JWT_SECRET dengan string baru (random)
#    - [ ] Update Midtrans keys ke production (jika ready)
#    - [ ] Set di Vercel Dashboard > Settings > Environment Variables
#    - [ ] Jangan paste .env file langsung, gunakan dashboard!
# ============================================
NODE_ENV=production

# Your Vercel domain (auto-set by Vercel)
# VERCEL_URL=your-project.vercel.app

