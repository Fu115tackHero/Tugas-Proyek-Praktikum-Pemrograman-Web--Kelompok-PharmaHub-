# ============================================
# ENVIRONMENT VARIABLES FOR VERCEL DEPLOYMENT
# ============================================
# Copy these to your Vercel Project Settings > Environment Variables
# DO NOT commit actual values to git!

# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================
# Get this from Neon Dashboard > Connection String
DATABASE_URL=postgresql://username:password@host.neon.tech/database?sslmode=require

# Legacy format (optional, for local development only)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=pharmahub

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a secure random string (minimum 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your_very_secure_jwt_secret_key_minimum_32_characters

# Token expiration time (examples: 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# ============================================
# SUPABASE (Image Storage)
# ============================================
# Get from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================
# MIDTRANS PAYMENT GATEWAY
# ============================================
# Get from Midtrans Dashboard
# For Production: Use production keys
# For Testing: Use sandbox keys
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key

# Set to "true" for production, "false" for sandbox
MIDTRANS_IS_PRODUCTION=false

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production

# Your Vercel domain (auto-set by Vercel)
# VERCEL_URL=your-project.vercel.app
