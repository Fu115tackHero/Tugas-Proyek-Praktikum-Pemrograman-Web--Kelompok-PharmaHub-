{
  "version": 2,
  "buildCommand": "npm run build",
  "framework": "vite",
  "redirects": [
    {
      "source": "/api/:path*",
      "destination": "http://localhost:3001/api/:path*",
      "permanent": false
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
